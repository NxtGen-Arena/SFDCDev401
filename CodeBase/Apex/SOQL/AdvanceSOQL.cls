public with sharing class AdvanceSOQL {
    
    /**
     * @Description: A Sales Manager wants to track the total revenue generated by each Sales Rep (OwnerId) for the current year
     * @Param: NA
     * @Return: void
     **/
    
    public void getSalesPerformance() {
        /**
         * @Filters: All Closed Opportunities with Close Date from current year
         * @Group by: OwnerId (Sales Rep)
         * @Order by:TotalSales(Alias) in descending order.    
         */
        AggregateResult[] results = [SELECT SUM(Amount) TotalSales, OwnerId
                                    FROM Opportunity 
                                    WHERE CloseDate = THIS_YEAR AND StageName = 'Closed Won'
                                    GROUP BY OwnerId];

        for (AggregateResult ar : results) {
            System.debug('Sales Rep: ' + ar.get('OwnerId') + ', Total Sales: ' + ar.get('TotalSales'));
        }
    }

    /**
     * @Description: A business wants to categorize Accounts based on their total Opportunity revenue:
     * High Value: Revenue > $500,000
     * Medium Value: Revenue between $100,000 and $500,000
     * Low Value: Revenue < $100,000
     * @Param: NA
     * @Return: void
     **/
    public void categorizeCustomers() 
    {
         /**
         * @Filters: All Closed Opportunities
         * @Group by: Account
         * @Order by: revenue to prioritize high-value accounts.
         * Uses HAVING to eliminate small accounts (TotalRevenue > 10,000).
         */
        AggregateResult[] results = [SELECT AccountId, SUM(Amount) TotalRevenue 
                                    FROM Opportunity 
                                    WHERE StageName = 'Closed Won' 
                                    GROUP BY AccountId 
                                    HAVING SUM(Amount) > 10000];

        for (AggregateResult ar : results) {
            Decimal revenue = (Decimal) ar.get('TotalRevenue');
            String category = revenue > 500000 ? 'High Value' :
                            revenue > 100000 ? 'Medium Value' : 'Low Value';

            System.debug('Account: ' + ar.get('AccountId') + ' - Category: ' + category);
        }
    }

    /**
     * @Description: A Support Team Manager wants to track the average time taken to resolve Cases for each support agent.
     * @Param: NA
     * @Return:
     */
    public void getCaseResolutionTime() 
    {
        /**
         * @Filters: All Closed Opportunities
         * @Group by: Owner (Support Agent)
         * @Aggregate on: Days_Open__c (ClosedDate - CreatedDate).
         * @Order by: revenue to prioritize high-value accounts.
         */
        AggregateResult[] results = [SELECT OwnerId, AVG(Days_Open__c) AvgResolutionTime 
                                    FROM Case 
                                    WHERE Status = 'Closed' 
                                    GROUP BY OwnerId];

        for (AggregateResult ar : results) {
            System.debug('Support Agent: ' + ar.get('OwnerId') + 
                        ', Avg Resolution Time: ' + ar.get('AvgResolutionTime') + ' days');
        }
    }

    /**
     * @Description: A SaaS company wants to monitor monthly revenue trends.
     * @Param: NA
     * @Return: void
     */
    public void getMonthlyRevenue() 
    {
        AggregateResult[] results = [SELECT CALENDAR_MONTH(CloseDate) Month, SUM(Amount) MonthlyRevenue 
                                    FROM Opportunity 
                                    WHERE CloseDate = LAST_N_MONTHS:12 AND StageName = 'Closed Won'
                                    GROUP BY CALENDAR_MONTH(CloseDate)
                                    ORDER BY CALENDAR_MONTH(CloseDate) ASC];

        for (AggregateResult ar : results) {
            System.debug('Month: ' + ar.get('Month') + ', Revenue: ' + ar.get('MonthlyRevenue'));
        }
    }

    /**
     * @Description:A company wants to track the number of leave days taken per employee.
     * @Param: NA
     * @Return: void
     */
    public void trackEmployeeLeave() 
    {
        AggregateResult[] results = [SELECT Employee__c, SUM(Leave_Days__c) TotalLeave 
                                    FROM Leave_Request__c 
                                    WHERE Leave_Status__c = 'Approved' 
                                    GROUP BY Employee__c
                                    HAVING SUM(Leave_Days__c) > 5
                                    ORDER BY SUM(Leave_Days__c) DESC];

        for (AggregateResult ar : results) {
            System.debug('Employee: ' + ar.get('Employee__c') + ', Total Leave Days: ' + ar.get('TotalLeave'));
        }
    }
}
